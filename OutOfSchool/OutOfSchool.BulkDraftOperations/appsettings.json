{
  "ConnectionStringsOverride": {
    "DefaultConnection": {
      "UseOverride": false,
      "Server": "",
      "Port": 3306,
      "Database": "",
      "UserId": "",
      "Password": "",
      "SslMode": "None",
      "GuidFormat": "Binary16"
    }
  },
  "AppDefaults": {
    "AccessLogEnabled": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Debug",
      "Serilog.Sinks.File",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/bulkoperations.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 2,
          "fileSizeLimitBytes": null,
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      },
      {
        "Name": "Debug"
      }
    ]
  },
  "FeatureManagement": {
    "Release1": true,
    "Release2": true,
    "Release3": false,
    "Images": true,
    "ShowForProduction": false,
    "TechAdminImport": true,
    "TechAdminExport": true,
    "EnableWorkshopGroupTypeField": true,
    "DirectionManagement": false,
    "AchievementManagement": false,
    "AdminsChildrenParentsManagement": false,
    "MessagingFeature": false,
    "PasswordLogin": false,
    "PasswordRegistration": false,
    "EmailConfirmation": false,
    "EmailManagement": false,
    "PasswordManagement": false,
    "OnlyUkrainianLanguage": true,
    "EnableWorkshopTags": false
  },
  "Elasticsearch": {
    "EnsureIndex": false,
    "CheckConnectivityDelayMs": 10000,
    "ConnectionWaitingTimeSec": 60,
    "EnableDebugMode": false,
    "WorkshopIndexName": "workshop",
    "CompetitiveEventIndexName": "competitiveevent",
    "Urls": [
      "https://localhost:9200"
    ],
    "User": "",
    "Password": "",
    "SynchronizationScheduler": {
      "OperationsPerTask": 10,
      "DelayBetweenTasksInMilliseconds": 60000
    }
  },
  "Redis": {
    "Enabled": false,
    "Server": "localhost",
    "Port": 6379,
    "Password": "",
    "AbsoluteExpirationRelativeToNowInterval": "01:00:00",
    "SlidingExpirationInterval": "00:10:00",
    "CheckAlivePollingInterval": "00:01:00"
  },
  "FileStorage": {
    "Provider": "GoogleCloud",
    "Containers": {
