{
  "ConnectionStringsOverride": {
    "DefaultConnection": {
      "UseOverride": false,
      "Server": "",
      "Port": 3306,
      "Database": "",
      "UserId": "",
      "Password": "",
      "SslMode": "None",
      "GuidFormat": "Binary16"
    }
  },
  "AppDefaults": {
    "City": "Київ",
    "AccessLogEnabled": true,
    "Version": "replace_me"
  },
  "AllowedHosts": "*",

