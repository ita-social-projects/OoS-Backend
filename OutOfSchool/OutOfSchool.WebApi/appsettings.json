  "FeatureManagement": {
    "Release1": true,
    "Release2": true,
    "Release3": false,
    "Images": true,
    "ShowForProduction": false,
    "TechAdminImport": true,
    "TechAdminExport": true,
    "EnableWorkshopGroupTypeField": true,
    "DirectionManagement": false,
    "AchievementManagement": false,
    "AdminsChildrenParentsManagement": false,
    "MessagingFeature": false,
    "PasswordLogin": false,
    "PasswordRegistration": false,
    "EmailConfirmation": false,
    "EmailManagement": false,
    "PasswordManagement": false,
    "OnlyUkrainianLanguage" : true
  },

  "Notifications": {
    "Enabled": true,
    "Grouped": [
      "Application"
    ]
  },

  "Parent": {
    "ChildrenMaxNumber": 20
  },

  "ApplicationsConstraints": {
    "ApplicationsLimit": 2,
    "ApplicationsLimitDays": 7
  },

  "MariaDbServerVersion": "11.3.2",

  "Redis": {
    "Enabled": false,
    "Server": "localhost",
    "Port": 6379,
    "Password": "",
    "AbsoluteExpirationRelativeToNowInterval": "01:00:00",
    "SlidingExpirationInterval": "00:10:00",
    "CheckAlivePollingInterval": "00:01:00"
  },
  "MemoryCache": {
    "AbsoluteExpirationRelativeToNowInterval": "01:00:00",
    "SlidingExpirationInterval": "00:10:00"
  },
  "RedisForTempSave": {
    "AbsoluteExpirationRelativeToNowInterval": "07:00:00:00"
  },
  "CacheProfiles": {
    "PrivateDurationInSeconds": 60,
    "PublicDurationInSeconds": 60
  },
  "Elasticsearch": {
    "EnsureIndex": false,
    "CheckConnectivityDelayMs": 10000,
    "ConnectionWaitingTimeSec": 60,
    "EnableDebugMode": false,
    "WorkshopIndexName": "workshop",
    "CompetitiveEventIndexName": "competitiveevent",
    "Urls": [
      ""
    ],
    "User": "",
    "Password": "",
    "SynchronizationScheduler": {
      "OperationsPerTask": 10,
      "DelayBetweenTasksInMilliseconds": 60000
    }
  },
  "Quartz": {
    "ConnectionStringKey": "DefaultConnection",
    "CronSchedules": {
      "GcpImagesSyncCronScheduleString": "0 0 0 * * ?",
      "StatisticReportsMakingCronScheduleString": "0 0 0 * * ?",
      "ApplicationStatusChangingCronScheduleString": "0 0 0 1 OCT ? *",
      "NotificationsClearingCronScheduleString": "0 0 0 * * ?",
      "AverageRatingCalculatingCronScheduleString": "0 0 4 * * ?",
      "LicenseApprovalNotificationCronScheduleString": "0 0 6 10 JAN ? *",
      "EmailSenderCronScheduleString": "0/30 * * * * ?"
    }
  },

  "QuartzMonitoring": {
    "Enabled": true,
    "Redis": {
      "Server": "localhost",
      "Port": 6379,
      "Password": "",
      "HistoryLength": 10
    },
    "RateLimiter": {
      "PermitLimit": 10,
      "Window": 60,
      "EnableIpBasedRateLimiting": true,
      "QueueLimit": 0,
      "RetryAfterSeconds": 60
    }
  },

  "ChangesLog": {
    "TrackedProperties": {
      "Provider": [ "FullTitle", "ShortTitle", "Contacts.Address", "InstitutionId", "InstitutionStatusId" ],
