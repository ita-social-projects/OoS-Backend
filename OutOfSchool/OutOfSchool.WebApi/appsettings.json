  "Images": {
    "Workshop": {
      "Specs": {
        "MinWidthPixels": 350,
        "MaxWidthPixels": 10000,
        "MinHeightPixels": 250,
        "MaxHeightPixels": 8000,
        "MaxSizeBytes": 16777216,
        "MinWidthHeightRatio": 1,
        "MaxWidthHeightRatio": 3,
        "SupportedFormats": [
          "jpeg",
          "png"
        ]
      },
      "Limits": {
        "MaxCountOfFiles": 10
      }
    },
    "Teacher": {
      "Specs": {
        "MinWidthPixels": 350,
        "MaxWidthPixels": 10000,
        "MinHeightPixels": 250,
        "MaxHeightPixels": 8000,
        "MaxSizeBytes": 16777216,
        "MinWidthHeightRatio": 0.5,
