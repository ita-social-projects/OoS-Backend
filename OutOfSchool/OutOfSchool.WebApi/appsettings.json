    "Providers": {
      "GoogleCloud": {
        "CredentialFilePath": ""
      },
      "AmazonS3": {
        "AccessKey": "",
        "SecretKey": "",
        "Region": "us-east-1",
        "ServiceUrl": ""
      },
      "Fake": {
      }
    }
